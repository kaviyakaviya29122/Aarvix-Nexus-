{
 "title": "AARVIX NEXUS",
 "uid": "nexus-main",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Workers online",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nexus_workers_online",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Recoveries (5m)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(nexus_recoveries_total[5m])",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Duplicates blocked (5m)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(nexus_duplicates_blocked_total[5m])",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Workers declared dead (5m)",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(nexus_workers_marked_offline_total[5m])",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Jobs by status",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nexus_jobs_by_status",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Throughput by outcome (jobs/s)",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(nexus_jobs_finished_total[1m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Job duration p50 / p95 (s)",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(nexus_job_duration_seconds_bucket[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(nexus_job_duration_seconds_bucket[1m])))",
     "legendFormat": "p50"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Stale deliveries dropped (fencing)",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(nexus_stale_deliveries_total[5m])",
     "legendFormat": ""
    }
   ]
  }
 ]
}