# Copy to .env and CHANGE EVERY VALUE before sharing the stack with anyone.
POSTGRES_PASSWORD=change-me-db-password
RABBITMQ_PASSWORD=change-me-mq-password
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_EMAIL=admin@aarvix.local
ADMIN_PASSWORD=ChangeMe12345
GRAFANA_PASSWORD=change-me-grafana
# Leave SMTP_HOST empty for dev: verification codes are printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@aarvix.local
